title Handmade Ceramics Online Store

phase 1

component storefront-webapp as "Ceramics Storefront" web-application [stories: 1, 2, 3, 4, 5, 6, 7, 8, 9]
component admin-webapp as "Ceramics Admin Portal" web-application [stories: 10, 11, 12]
